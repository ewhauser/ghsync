{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://frontier.invalid/schemas/phase0-delivery-record.schema.json",
  "title": "Frontier Phase-0 delivery observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "delivery_guid",
    "github_delivered_at",
    "event",
    "action",
    "repository",
    "source"
  ],
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1
    },
    "delivery_guid": {
      "type": "string",
      "minLength": 1
    },
    "github_delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingress_received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "full_name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "full_name": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        }
      }
    },
    "pull_request_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "before": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "stack": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "size",
        "position",
        "base_ref",
        "base_sha"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "base_ref": {
          "type": "string"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source": {
      "enum": [
        "github_app_delivery_api",
        "frontier_ingress"
      ]
    },
    "duplicate": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
